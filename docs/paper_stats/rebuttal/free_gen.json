 "shots": {
  "zh": [
   [
    "对牛弹琴",
    "To speak to someone who cannot understand or appreciate what is said; to address the wrong audience."
   ],
   [
    "井底之蛙",
    "A person with a very narrow outlook who knows little of the wider world."
   ],
   [
    "杯弓蛇影",
    "To be frightened by imaginary dangers; needless suspicion and fear."
   ]
  ],
  "hi": [
   [
    "नाच न जाने आँगन टेढ़ा",
    "Blaming circumstances or tools for one's own lack of skill."
   ],
   [
    "उल्टा चोर कोतवाल को डाँटे",
    "The wrongdoer accusing the innocent person who caught him."
   ],
   [
    "थोथा चना बाजे घना",
    "Those with little substance or knowledge make the most noise."
   ]
  ],
  "ar": [
   [
    "رجع بخفي حنين",
    "He came back empty-handed, having failed to get what he went for."
   ],
   [
    "يد واحدة لا تصفق",
    "One person alone cannot achieve much; cooperation is needed."
   ],
   [
    "الوقت كالسيف إن لم تقطعه قطعك",
    "Time must be used well, or it will work against you."
   ]
  ]
 },
